# Resolve the language codes to look for, e.g. "fr" and "fr-fr".
$culture = [Globalization.CultureInfo]::CurrentUICulture
$twoLetter = $culture.TwoLetterISOLanguageName.ToLowerInvariant()
$fullName = $culture.Name.ToLowerInvariant()
if ($Lang) { $twoLetter = $fullName = $Lang.ToLowerInvariant() }

$strings = @{}
foreach ($kv in $Builtin['en'].GetEnumerator()) { $strings[$kv.Key] = $kv.Value }   # English is the base: missing keys fall back to it
if ($Builtin.ContainsKey($twoLetter)) { foreach ($kv in $Builtin[$twoLetter].GetEnumerator()) { $strings[$kv.Key] = $kv.Value } }

# Optional external files override the built-in strings: lang\xx.txt first, then lang\xx-yy.txt.
# Format: one "key=value" per line; lines starting with '#' are comments; "\n" means a line break.
$langDir = Join-Path $PSScriptRoot 'lang'
foreach ($code in @($twoLetter, $fullName) | Select-Object -Unique) {
    $file = Join-Path $langDir "$code.txt"
    if (Test-Path -LiteralPath $file) {
        foreach ($raw in Get-Content -LiteralPath $file -Encoding UTF8) {
            $eq = $raw.IndexOf('=')
            if ($eq -gt 0 -and $raw[0] -ne '#') {
                $strings[$raw.Substring(0, $eq).Trim()] = $raw.Substring($eq + 1).Replace('\n', "`n")
            }
        }
    }
}

# Returns the localized string for $Key, formatted with $FormatArgs ({0}, {1}...).
# An unknown key returns the key itself, so a missing translation is visible but never crashes.
function T {
    param([string]$Key, [object[]]$FormatArgs = @())
    $v = $strings[$Key]
    if ($null -eq $v) { return $Key }
    if ($FormatArgs.Count -eq 0) { return $v }
    return [string]::Format($v, $FormatArgs)
}

# ------------------------------------------------------------------------------------------------
# Backend: process enumeration and termination, strictly limited to current user + current session.
# Written in C# because it needs Win32 APIs (process tokens, process times, shell icons).
# Compiled in memory by Add-Type at startup; nothing is written to disk.
# ------------------------------------------------------------------------------------------------
Add-Type -Language CSharp -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Diagnostics;
using System.Drawing;
using System.Runtime.InteropServices;
using System.Security.Principal;
using System.Windows.Forms;

namespace UserTaskManagerPS
{
    // One row of the list: a snapshot of a process taken during Enumerate().
    public sealed class ProcRow
    {
        public int Pid;
        public string Name;
        public string Title;
        public long MemoryBytes;
        public long StartTime;    // creation time (FILETIME); detects PID reuse before acting
        public long CpuTicks;     // cumulative kernel + user CPU time, in 100 ns units
        public double CpuPercent; // recent CPU usage, computed by the UI between two refreshes
        public bool HasWindow;    // true when the process has a visible, titled main window
        public string Path;       // full executable path, used to fetch the icon
    }

    // Single entry point for every process operation. Each call re-checks that the target process
    // belongs to the current user AND the current session, so system processes and other users'
    // sessions can never be listed or terminated, even if a PID were passed in directly.
    public static class UserScope
    {
        const uint PROCESS_TERMINATE = 0x0001;
        const uint PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
        const uint TOKEN_QUERY = 0x0008;
        const int TokenUser = 1;

        [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
        [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr h);
        [DllImport("kernel32.dll", SetLastError = true)] static extern bool TerminateProcess(IntPtr h, uint exitCode);
        [DllImport("kernel32.dll", SetLastError = true)] static extern bool ProcessIdToSessionId(int pid, out int sessionId);
        [DllImport("kernel32.dll", SetLastError = true)] static extern bool GetProcessTimes(IntPtr h, out long create, out long exit, out long kernel, out long user);
        [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern bool QueryFullProcessImageName(IntPtr h, int flags, System.Text.StringBuilder name, ref int size);
        [DllImport("advapi32.dll", SetLastError = true)] static extern bool OpenProcessToken(IntPtr h, uint access, out IntPtr token);
        [DllImport("advapi32.dll", SetLastError = true)] static extern bool GetTokenInformation(IntPtr token, int cls, IntPtr buf, int len, out int ret);

        public static readonly SecurityIdentifier CurrentUser = WindowsIdentity.GetCurrent().User;
        public static readonly int CurrentSession = Process.GetCurrentProcess().SessionId;
        public static readonly int SelfPid = Process.GetCurrentProcess().Id;

        // Opens the process only if it runs in the current session and its token user is the
        // current user. Returns false for system/protected/other-user processes (access denied).
        // On success the caller owns the handle and must close it.
        static bool TryOpenOwned(int pid, uint access, out IntPtr handle, out long startTime)
        {
            handle = IntPtr.Zero; startTime = 0;
            if (pid <= 4 || pid == SelfPid) return false;
            int session;
            if (!ProcessIdToSessionId(pid, out session) || session != CurrentSession) return false;
            IntPtr h = OpenProcess(access | PROCESS_QUERY_LIMITED_INFORMATION, false, pid);
            if (h == IntPtr.Zero) return false;
            bool ok = false;
            try
            {
                if (!IsOwnedByCurrentUser(h)) return false;
                long exit, kernel, user;
                if (!GetProcessTimes(h, out startTime, out exit, out kernel, out user)) return false;
                ok = true; handle = h; return true;
            }
            finally { if (!ok) CloseHandle(h); }
        }

        // Reads the TokenUser SID of the process token and compares it with the current user's SID.
        static bool IsOwnedByCurrentUser(IntPtr processHandle)
        {
            IntPtr token;
            if (!OpenProcessToken(processHandle, TOKEN_QUERY, out token)) return false;
            IntPtr buf = IntPtr.Zero;
            try
            {
                int len;
                GetTokenInformation(token, TokenUser, IntPtr.Zero, 0, out len);
                if (len <= 0) return false;
                buf = Marshal.AllocHGlobal(len);
                if (!GetTokenInformation(token, TokenUser, buf, len, out len)) return false;
                var sid = new SecurityIdentifier(Marshal.ReadIntPtr(buf));
                return sid.Equals(CurrentUser);
            }
            finally { if (buf != IntPtr.Zero) Marshal.FreeHGlobal(buf); CloseHandle(token); }
        }

        // Returns all processes owned by the current user in the current session.
        // The UI then keeps only those with a window (HasWindow).
        public static List<ProcRow> Enumerate()
        {
            var rows = new List<ProcRow>();
            foreach (Process p in Process.GetProcesses())
            {
                try
                {
                    IntPtr h; long start;
                    if (!TryOpenOwned(p.Id, 0, out h, out start)) continue;
                    string path = null; long cpu = 0;
                    try
                    {
                        long c, e, k, u;
                        if (GetProcessTimes(h, out c, out e, out k, out u)) cpu = k + u;
                        var sb = new System.Text.StringBuilder(1024);
                        int size = sb.Capacity;
                        if (QueryFullProcessImageName(h, 0, sb, ref size)) path = sb.ToString();
                    }
                    finally { CloseHandle(h); }

                    string title = ""; bool hasWindow = false;
                    try { title = p.MainWindowTitle ?? ""; hasWindow = p.MainWindowHandle != IntPtr.Zero && title.Length > 0; } catch { }
                    long mem = 0;
                    try { mem = p.WorkingSet64; } catch { }

                    rows.Add(new ProcRow { Pid = p.Id, Name = p.ProcessName, Title = title, MemoryBytes = mem, StartTime = start, CpuTicks = cpu, HasWindow = hasWindow, Path = path });
                }
                catch { }
                finally { p.Dispose(); }
            }
            return rows;
        }

        // Force quit. Re-validates owner, session and start time (PID not reused) right before
        // TerminateProcess. Returns null on success, otherwise an error message for the user.
        public static string Kill(ProcRow row, string errNotFound, string errPidReused)
        {
            IntPtr h; long start;
            if (!TryOpenOwned(row.Pid, PROCESS_TERMINATE, out h, out start)) return errNotFound;
            try
            {
                if (start != row.StartTime) return errPidReused;
                if (!TerminateProcess(h, 1)) return new Win32Exception(Marshal.GetLastWin32Error()).Message;
                return null;
            }
            finally { CloseHandle(h); }
        }

        // Polite close: asks the main window to close (like clicking its X), so the application
        // can prompt to save its work. Same re-validation as Kill. Returns null on success.
        public static string Close(ProcRow row, string errNotFound, string errPidReused, string errNoWindow)
        {
            IntPtr h; long start;
            if (!TryOpenOwned(row.Pid, 0, out h, out start)) return errNotFound;
            CloseHandle(h);
            if (start != row.StartTime) return errPidReused;
            try
            {
                using (Process p = Process.GetProcessById(row.Pid))
                    return p.CloseMainWindow() ? null : errNoWindow;
            }
            catch (Exception ex) { return ex.Message; }
        }
    }

    // 16x16 icons of the executables, cached by path so each file is read only once.
    public sealed class IconCache
    {
        [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Auto)]
        struct SHFILEINFO
        {
            public IntPtr hIcon; public int iIcon; public uint dwAttributes;
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)] public string szDisplayName;
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 80)] public string szTypeName;
        }
        [DllImport("shell32.dll", CharSet = CharSet.Auto)] static extern IntPtr SHGetFileInfo(string path, uint attrs, ref SHFILEINFO fi, uint size, uint flags);
        [DllImport("user32.dll")] static extern bool DestroyIcon(IntPtr h);
        const uint SHGFI_ICON = 0x100, SHGFI_SMALLICON = 0x1;
        const string DefaultKey = "(default)";

        public readonly ImageList Images = new ImageList { ColorDepth = ColorDepth.Depth32Bit, ImageSize = new Size(16, 16) };
        readonly HashSet<string> known = new HashSet<string>();
        public IconCache() { Images.Images.Add(DefaultKey, SystemIcons.Application); known.Add(DefaultKey); }

        public string KeyFor(string path)
        {
            if (string.IsNullOrEmpty(path)) return DefaultKey;
            if (known.Contains(path)) return path;
            try
            {
                var fi = new SHFILEINFO();
                SHGetFileInfo(path, 0, ref fi, (uint)Marshal.SizeOf(fi), SHGFI_ICON | SHGFI_SMALLICON);
                if (fi.hIcon == IntPtr.Zero) return DefaultKey;
                try { using (Icon ico = (Icon)Icon.FromHandle(fi.hIcon).Clone()) Images.Images.Add(path, ico); }
                finally { DestroyIcon(fi.hIcon); }
                known.Add(path);
                return path;
            }
            catch { return DefaultKey; }
        }
    }

    // Sorts the list by the clicked column (0 Name, 1 PID, 2 Window, 3 CPU, 4 Memory).
    public sealed class RowComparer : System.Collections.IComparer
    {
        public int Column = 0;
        public bool Ascending = true;
        public int Compare(object a, object b)
        {
            ProcRow x = (ProcRow)((ListViewItem)a).Tag, y = (ProcRow)((ListViewItem)b).Tag;
            int r;
            switch (Column)
            {
                case 1: r = x.Pid.CompareTo(y.Pid); break;
                case 2: r = string.Compare(x.Title, y.Title, StringComparison.CurrentCultureIgnoreCase); break;
                case 3: r = x.CpuPercent.CompareTo(y.CpuPercent); break;
                case 4: r = x.MemoryBytes.CompareTo(y.MemoryBytes); break;
                default: r = string.Compare(x.Name, y.Name, StringComparison.CurrentCultureIgnoreCase); break;
            }
            return Ascending ? r : -r;
        }
    }
}
