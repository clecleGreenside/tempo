# Rebuilds the footer text. Skipped while the user is selecting or has clicked in the footer,
# otherwise the 1-second clock update would reset the selection and break copy/paste.
function Update-Status {
    if ($info.SelectionLength -gt 0 -or $info.Focused) { return }
    $text = @(
        "$($infoLabels[0])`t$([Security.Principal.WindowsIdentity]::GetCurrent().Name)"
        "$($infoLabels[1])`t$env:COMPUTERNAME"
        "$($infoLabels[2])`t$([DateTime]::Now.ToString('G'))"
        (T 'note')
    ) -join "`r`n"
    if ($info.Text -ne $text) { $info.Text = $text }
}
Update-Status

# Clock: refreshes the footer date/time every second.
$clock = New-Object Windows.Forms.Timer
$clock.Interval = 1000
$clock.add_Tick({ Update-Status })
$clock.Start()

# Identifies a process across refreshes. Includes the start time because Windows reuses PIDs.
function Get-RowKey($row) { "$($row.Pid):$($row.StartTime)" }

# Re-enumerates the processes and updates the list in place (add / update / remove rows),
# which keeps the selection and scroll position stable between refreshes.
function Refresh-List {
    $memUnit = T 'mem.unit'
    $now = [Diagnostics.Stopwatch]::GetTimestamp()
    $seen = New-Object Collections.Generic.HashSet[string]

    $list.BeginUpdate()
    try {
        foreach ($r in [UserTaskManagerPS.UserScope]::Enumerate()) {
            if (-not $r.HasWindow) { continue }   # applications only (processes with a visible window)

            $key = Get-RowKey $r
            [void]$seen.Add($key)

            # CPU % = CPU time used since the previous sample / (elapsed time x number of cores),
            # i.e. a share of the whole machine, like the Windows Task Manager. The first sample of a
            # process shows 0 %. A sample is only renewed after 0.5 s, so clicking Refresh right after
            # an automatic refresh does not produce meaningless values.
            if (-not $samples.ContainsKey($key)) {
                $samples[$key] = @{ Ticks = $r.CpuTicks; Stamp = $now; Pct = 0.0 }
            }
            else {
                $s = $samples[$key]
                $elapsed = ($now - $s.Stamp) * 1e7 / [Diagnostics.Stopwatch]::Frequency
                if ($elapsed -ge 5e6) {
                    $pct = 100.0 * ($r.CpuTicks - $s.Ticks) / ($elapsed * [Environment]::ProcessorCount)
                    if ($pct -lt 0) { $pct = 0 }; if ($pct -gt 100) { $pct = 100 }
                    $s.Pct = $pct; $s.Ticks = $r.CpuTicks; $s.Stamp = $now
                }
            }
            $r.CpuPercent = $samples[$key].Pct
            $cpuText = '{0:N1} %' -f $samples[$key].Pct
            $memText = '{0:N1} {1}' -f ($r.MemoryBytes / 1MB), $memUnit

            if ($items.ContainsKey($key)) {
                $it = $items[$key]
                $it.Tag = $r
                if ($it.SubItems[2].Text -ne $r.Title) { $it.SubItems[2].Text = $r.Title }
                if ($it.SubItems[3].Text -ne $cpuText) { $it.SubItems[3].Text = $cpuText }
                if ($it.SubItems[4].Text -ne $memText) { $it.SubItems[4].Text = $memText }
            }
            else {
                # The unary comma stops PowerShell from unrolling the array into separate constructor arguments.
                $it = New-Object Windows.Forms.ListViewItem(, [string[]]@($r.Name, [string]$r.Pid, $r.Title, $cpuText, $memText))
                $it.Tag = $r
                $it.ImageKey = $icons.KeyFor($r.Path)
                $items[$key] = $it
                [void]$list.Items.Add($it)
            }
        }

        # Remove rows of processes that have exited (or no longer have a window).
        foreach ($k in @($items.Keys)) {
            if (-not $seen.Contains($k)) {
                $list.Items.Remove($items[$k])
                $items.Remove($k)
                $samples.Remove($k)
            }
        }
        $list.Sort()
    }
    finally { $list.EndUpdate() }
}

# Closes ($force = $false) or force-quits ($force = $true) the selected rows.
# Force quit asks for confirmation first ("No" is the default button). Errors are collected and
# shown in a single message box at the end.
function Invoke-Action([bool]$force) {
    $rows = @($list.SelectedItems | ForEach-Object { $_.Tag })
    if ($rows.Count -eq 0) { return }

    $what = if ($rows.Count -eq 1) { T 'what.one' @($rows[0].Name, $rows[0].Pid) } else { T 'what.many' @($rows.Count) }
    if ($force) {
        $res = [Windows.Forms.MessageBox]::Show($form, (T 'confirm.kill' @($what)), $form.Text,
            'YesNo', 'Warning', 'Button2')
        if ($res -ne 'Yes') { return }
    }

    $errors = @()
    foreach ($r in $rows) {
        $err = if ($force) {
            [UserTaskManagerPS.UserScope]::Kill($r, (T 'err.notfound'), (T 'err.pidreused'))
        } else {
            [UserTaskManagerPS.UserScope]::Close($r, (T 'err.notfound'), (T 'err.pidreused'), (T 'err.nowindow' @((T 'kill'))))
        }
        if ($err) { $errors += "$($r.Name) ($($r.Pid)) : $err" }
    }
    if ($errors.Count -gt 0) {
        [Windows.Forms.MessageBox]::Show($form, ($errors -join "`n"), $form.Text, 'OK', 'Error') | Out-Null
    }
    Refresh-List
}

# Event wiring. Delete key = Force quit; clicking a column header sorts (click again to reverse).
$btnRefresh.add_Click({ Refresh-List })
$btnClose.add_Click({ Invoke-Action $false })
$btnKill.add_Click({ Invoke-Action $true })
$menu.Items[0].add_Click({ Invoke-Action $false })
$menu.Items[1].add_Click({ Invoke-Action $true })
$list.add_KeyDown({ param($s, $e) if ($e.KeyCode -eq 'Delete') { Invoke-Action $true } })
$list.add_ColumnClick({
    param($s, $e)
    if ($comparer.Column -eq $e.Column) { $comparer.Ascending = -not $comparer.Ascending }
    else { $comparer.Column = $e.Column; $comparer.Ascending = $true }
    $list.Sort()
})

# Auto refresh of the list every 2 seconds, started once the window is shown.
$timer = New-Object Windows.Forms.Timer
$timer.Interval = 2000
$timer.add_Tick({ Refresh-List })
$form.add_Load({ Refresh-List; $timer.Start() })
$form.add_FormClosed({ $timer.Stop(); $clock.Stop() })

[Windows.Forms.Application]::EnableVisualStyles()
[Windows.Forms.Application]::Run($form)
