#requires -Version 5.1
<#
.SYNOPSIS
    "User" Task Manager: lists and closes the current user's applications only.

.DESCRIPTION
    Shows ONLY the processes that belong to the current user AND to the current Windows session,
    and only those with a visible main window (applications). System processes (SYSTEM,
    LOCAL SERVICE, services...) and processes of other users / other sessions (multi-user
    Windows, Remote Desktop Services) are never listed and can never be closed from here.

    Features:
      - Close (polite WM_CLOSE) or Force quit (TerminateProcess) the selected applications.
      - Name / PID / window title / CPU % / memory columns, sortable by clicking a header.
      - Auto refresh every 2 s, plus a Refresh button.
      - Copyable footer with user, server (machine) name and live date/time.
      - Multi-language UI (en, fr, de, es, it built in; more via lang\xx.txt files).
      - AXA logo embedded in the script (no external file needed).

    Nothing is compiled to disk: the small C# helpers below are compiled in memory by Add-Type
    each time the script starts. No administrator rights are required or requested.

.PARAMETER Lang
    Optional two-letter language code (e.g. en, fr, de) that overrides the Windows UI language.
    Handy for testing translations.

.EXAMPLE
    powershell -ExecutionPolicy Bypass -File UserTaskManager.ps1
.EXAMPLE
    powershell -ExecutionPolicy Bypass -File UserTaskManager.ps1 -Lang de

.NOTES
    Requires Windows PowerShell 5.1 (built into Windows 10/11 and Windows Server 2016+).
    Keep this file pure ASCII: Windows PowerShell 5.1 reads BOM-less files with the ANSI code
    page, so accented characters would be displayed incorrectly.
#>
param(
    [string]$Lang = ''
)

# WinForms needs a single-threaded apartment (STA). Windows PowerShell 5.1 console is STA by
# default, but some hosts are not: in that case, relaunch this script in a new STA process.
if ([Threading.Thread]::CurrentThread.ApartmentState -ne 'STA') {
    $argList = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-STA', '-File', "`"$PSCommandPath`"")
    if ($Lang) { $argList += @('-Lang', $Lang) }
    Start-Process -FilePath (Join-Path $PSHOME 'powershell.exe') -ArgumentList $argList
    return
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

