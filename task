'@
$axaIconStream = New-Object IO.MemoryStream(, [Convert]::FromBase64String(($axaIconBase64 -replace '\s', '')))
$form.Icon = New-Object Drawing.Icon($axaIconStream)

# Toolbar: Refresh / Close / Force quit.
$top = New-Object Windows.Forms.FlowLayoutPanel
$top.Dock = 'Top'; $top.Height = 40; $top.Padding = New-Object Windows.Forms.Padding(6, 4, 6, 0); $top.WrapContents = $false

# All buttons share the same width: the widest localized label, 110 px minimum.
$btnWidth = 110
foreach ($k in 'refresh', 'close', 'kill') {
    $w = 28 + [Windows.Forms.TextRenderer]::MeasureText((T $k), $form.Font).Width
    if ($w -gt $btnWidth) { $btnWidth = $w }
}

$btnRefresh = New-Object Windows.Forms.Button
$btnRefresh.Text = T 'refresh'; $btnRefresh.Size = New-Object Drawing.Size($btnWidth, 27); $btnRefresh.Margin = New-Object Windows.Forms.Padding(3)

$btnClose = New-Object Windows.Forms.Button
$btnClose.Text = T 'close'; $btnClose.Size = New-Object Drawing.Size($btnWidth, 27); $btnClose.Margin = New-Object Windows.Forms.Padding(3)

$btnKill = New-Object Windows.Forms.Button
$btnKill.Text = T 'kill'; $btnKill.Size = New-Object Drawing.Size($btnWidth, 27); $btnKill.Margin = New-Object Windows.Forms.Padding(3)

$top.Controls.AddRange(@($btnRefresh, $btnClose, $btnKill))

# Footer: one read-only, multi-line TextBox so everything can be selected and copied at once
# (Ctrl+A, Ctrl+C). Labels and values are separated by a tab, which also pastes nicely into Excel.
$infoLabels = @((T 'user' @('')).TrimEnd(), (T 'server' @('')).TrimEnd(), (T 'datetime' @('')).TrimEnd())
$info = New-Object Windows.Forms.TextBox
$info.Multiline = $true; $info.ReadOnly = $true; $info.WordWrap = $false
$info.BorderStyle = 'None'; $info.BackColor = [Drawing.SystemColors]::Control; $info.TabStop = $false
$info.Dock = 'Fill'

Add-Type -Language CSharp -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
// Sets the tab stop position of a TextBox (EM_SETTABSTOPS), used to align the footer values.
public static class PSNativeTabs
{
    [DllImport("user32.dll")] static extern IntPtr SendMessage(IntPtr hWnd, int msg, IntPtr wParam, int[] lParam);
    public static void SetTabStop(IntPtr handle, int stop) { SendMessage(handle, 0x00CB, (IntPtr)1, new[] { stop }); }
}
'@

# Places the footer tab stop just after the longest label, in dialog units
# (1 dialog unit = 1/4 of the font's average character width).
$script:SetInfoTabStop = {
    $flags = [Windows.Forms.TextFormatFlags]::NoPadding
    $big = New-Object Drawing.Size([int]::MaxValue, [int]::MaxValue)
    $labelPx = 0
    foreach ($l in $infoLabels) {
        $w = [Windows.Forms.TextRenderer]::MeasureText($l, $info.Font, $big, $flags).Width
        if ($w -gt $labelPx) { $labelPx = $w }
    }
    $alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
    $avg = [Windows.Forms.TextRenderer]::MeasureText($alphabet, $info.Font, $big, $flags).Width / 52.0
    $stop = [int](($labelPx + 14) * 4 / $avg)
    [PSNativeTabs]::SetTabStop($info.Handle, $stop)
    $info.Invalidate()
}
$info.add_HandleCreated({ & $script:SetInfoTabStop })

$statusBar = New-Object Windows.Forms.Panel
$statusBar.Dock = 'Bottom'; $statusBar.Height = 4 * 17 + 14
$statusBar.Padding = New-Object Windows.Forms.Padding(8, 6, 0, 0)
$statusBar.Controls.Add($info)

$list = New-Object Windows.Forms.ListView
$list.Dock = 'Fill'; $list.View = 'Details'; $list.FullRowSelect = $true
$list.HideSelection = $false; $list.MultiSelect = $true
[void]$list.Columns.Add((T 'col.name'), 180)
[void]$list.Columns.Add((T 'col.pid'), 60, 'Right')
[void]$list.Columns.Add((T 'col.window'), 300)
[void]$list.Columns.Add((T 'col.cpu'), 90, 'Right')
[void]$list.Columns.Add((T 'col.memory'), 100, 'Right')
$list.SmallImageList = $icons.Images
$list.ListViewItemSorter = $comparer
# Enable double buffering (a protected property, set via reflection) to avoid flicker on refresh.
